{
  "$schema": "./config.schema.json",

  "title": "Content",
  "siteName": "Example Site",
  "logo": "./logo.png",
  "lang": "en",

  "repo": "owner/repo",
  "branch": "main",
  "siteUrl": "https://example.com",
  "timeZone": "UTC",

  "auth": {
    "base": "https://cms-auth.example.com"
  },

  "collection": {
    "label": "news",
    "dir": "src/content/news",
    "url": "/news/{id}/"
  },

  "media": {
    "dir": "public/uploads",
    "url": "/uploads",
    "maxWidth": 1600,
    "quality": 0.82
  },

  "preview": {
    "url": "/news/preview/"
  },

  "deploy": {
    "skipCiForDrafts": true
  }
}
