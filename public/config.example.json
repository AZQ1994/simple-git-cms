{
  "$schema": "./config.schema.json",

  "title": "Content",
  "siteName": "Example Site",
  "logo": "./logo.png",
  "lang": "en",

  "repo": "owner/repo",
  "branch": "main",
  "siteUrl": "https://example.com",
  "timeZone": "UTC",

  "auth": {
    "base": "https://cms-auth.example.com"
  },

  "collections": [
    {
      "name": "news",
      "label": "News",
      "dir": "src/content/news",
      "url": "/news/{id}/",
      "imageField": "image",
      "preview": "/news/preview/"
    },
    {
      "name": "notices",
      "label": "Notices",
      "dir": "src/content/notices",
      "url": "/notices/{id}/"
    }
  ],

  "media": {
    "dir": "public/uploads",
    "url": "/uploads",
    "maxWidth": 1600,
    "quality": 0.82,
    "maxFileMB": 20
  },

  "blocks": [
    {
      "tag": "YouTube",
      "label": "YouTube",
      "preview": "https://i.ytimg.com/vi/{id}/hqdefault.jpg",
      "fields": [{ "name": "id", "label": "Video ID", "placeholder": "dQw4w9WgXcQ" }]
    },
    {
      "tag": "aside",
      "name": "notice",
      "label": "Notice",
      "attrs": { "class": "notice" },
      "fields": [{ "name": "text", "from": "content", "multiline": true }]
    },
    {
      "tag": "iframe",
      "name": "video",
      "label": "Video",
      "starts": { "src": "https://www.youtube.com/embed/" },
      "fields": [{ "name": "src", "label": "Embed address", "placeholder": "https://www.youtube.com/embed/dQw4w9WgXcQ" }]
    },
    {
      "tag": "table",
      "label": "Advanced table",
      "edit": "table"
    }
  ],

  "deploy": {
    "skipCiForDrafts": true
  },

  "actions": [
    {
      "label": "Publish to the live site",
      "workflow": "release.yml",
      "confirm": "Publish what is on the test site now to the live site?",
      "url": "https://example.com"
    }
  ]
}
