{
  "$schema": "./config.schema.json",

  "title": "Content",
  "siteName": "Example Site",
  "logo": "./logo.png",
  "lang": "en",

  "repo": "owner/repo",
  "branch": "main",
  "siteUrl": "https://example.com",
  "timeZone": "UTC",

  "auth": {
    "base": "https://cms-auth.example.com"
  },

  "collection": {
    "label": "news",
    "dir": "src/content/news",
    "imageField": "image",
    "url": "/news/{id}/"
  },

  "media": {
    "dir": "public/uploads",
    "url": "/uploads",
    "maxWidth": 1600,
    "quality": 0.82,
    "maxFileMB": 20
  },

  "blocks": [
    {
      "tag": "YouTube",
      "label": "YouTube",
      "preview": "https://i.ytimg.com/vi/{id}/hqdefault.jpg",
      "fields": [{ "name": "id", "label": "Video ID", "placeholder": "dQw4w9WgXcQ" }]
    },
    {
      "tag": "aside",
      "name": "notice",
      "label": "Notice",
      "attrs": { "class": "notice" },
      "fields": [{ "name": "text", "from": "content", "multiline": true }]
    },
    {
      "tag": "table",
      "label": "Advanced table",
      "edit": "table"
    }
  ],

  "preview": {
    "url": "/news/preview/"
  },

  "deploy": {
    "skipCiForDrafts": true
  }
}
